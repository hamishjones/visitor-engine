{
  "manifest_version": 3,
  "name": "Visitor Engine",
  "version": "0.1.0",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://*.linkedin.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.linkedin.com/*/messaging/*"],
    "js": ["content.js"]
  }]
}
